# ---------------------------------------------------------------------------
# Client File-Access Portal — environment configuration
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# Postgres connection string. Any Postgres host works — the app uses its own
# built-in magic-link auth, so it does NOT need Supabase's auth features, only
# a plain Postgres database. Free option (no 2-project cap): Neon (neon.tech).
# Paste the connection string your provider gives you here.
#   Neon example: postgres://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgres://user:password@localhost:5432/portal

# Public base URL of the deployed app (used in emails / login links).
APP_URL=http://localhost:3000

# Secret used to sign session + magic-link tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-string

# --- Object storage (S3-compatible) ----------------------------------------
# Default: Backblaze B2 (cheapest storage, ~$6/TB-month). Any S3-compatible
# store works too (e.g. Cloudflare R2) — just change the endpoint + region.
#
# Backblaze B2 values (from your B2 bucket + application key):
#   STORAGE_ENDPOINT : the bucket's S3 endpoint, e.g. https://s3.us-west-004.backblazeb2.com
#   STORAGE_REGION   : the region in that endpoint, e.g. us-west-004
#   STORAGE_ACCESS_KEY_ID     : the application keyID
#   STORAGE_SECRET_ACCESS_KEY : the applicationKey
STORAGE_ENDPOINT=https://s3.us-west-004.backblazeb2.com
STORAGE_REGION=us-west-004
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=lesson-plans

# Optional: serve download links through a CDN/custom domain for free egress.
# Put Cloudflare in front of the B2 bucket (Bandwidth Alliance) and set this to
# that host, e.g. https://files.portal.example.com. Leave empty to hit B2
# directly (B2 gives 3× your stored volume in free egress each month).
STORAGE_PUBLIC_BASE_URL=

# For Cloudflare R2 instead of B2, use:
#   STORAGE_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
#   STORAGE_REGION=auto   (R2 has $0 egress; STORAGE_PUBLIC_BASE_URL not needed)

# --- Email (Resend) --------------------------------------------------------
# Bulk-capable transactional provider. NEVER Gmail (500/day cap is the bug
# we are fixing). Configure SPF, DKIM and DMARC on the sending domain.
RESEND_API_KEY=
EMAIL_FROM="Teacher Eva & Manuel <no-reply@portal.example.com>"

# Set to "1" to print emails/links to the server console instead of sending
# (handy for local dev before Resend/DNS is configured).
EMAIL_DRY_RUN=1
